<?php

use Krystal\Form\Element;

?>

<form class="card card-body" autocomplete="off">
    <?= Element::hidden('category[id]', $category->getId()); ?>

    <div class="mb-3">
        <label class="form-label"><?= $this->translate('Name'); ?></label>
        <?= Element::text('category[name]', $category->getName(), ['class' => 'form-control', 'placeholder' => $this->translate('Category name')]); ?>
    </div>

    <div class="mb-3">
        <label class="form-label"><?= $this->translate('Order'); ?></label>
        <?= Element::text('category[order]', $category->getOrder(), ['class' => 'form-control', 'placeholder' => $this->translate('Sorting order')]); ?>
    </div>

    <div class="mb-3">
        <label class="form-label"><?= $this->translate('Mark for right answer'); ?></label>
        <?= Element::text('category[mark]', $category->getMark(), ['class' => 'form-control']); ?>
    </div>

    <div class="mb-3">
        <label class="form-label"><?= $this->translate('Listing limit'); ?></label>
        <?= Element::text('category[limit]', $category->getLimit(), ['class' => 'form-control']); ?>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => !$category->getId(),
        'add' => 'Quiz:Admin:Category@addAction',
        'edit' => 'Quiz:Admin:Category@editAction',
        'save' => 'Quiz:Admin:Category@saveAction',
        'cancel' => 'Quiz:Admin:Browser@indexAction'
    ]); ?>
</form>